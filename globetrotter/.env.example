# Copy to `.env` and adjust. docker-compose reads from this file by default.
# Do NOT commit a real `.env` with secrets.

# --- Postgres ---
POSTGRES_USER=globetrotter
POSTGRES_PASSWORD=changeme
POSTGRES_DB=globetrotter
POSTGRES_PORT=5432

# When the backend lands, DATABASE_URL is the convention to expose to it:
# DATABASE_URL=postgres://globetrotter:changeme@db:5432/globetrotter

# --- Backend / auth ---
# Long random string. Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-me-with-a-long-random-string
# Access-token lifetime in seconds (15 min default; bump as needed)
JWT_EXPIRES_IN=900
# bcrypt cost factor. 10 ≈ 100ms; 12 ≈ 400ms. Bump for prod, keep low for hackathon demos.
BCRYPT_ROUNDS=10

# --- Email / OTP (Gmail SMTP) ---
# The Gmail address used as the sender.
# IMPORTANT: the value below MUST be a Google "App Password" (16 chars, no spaces),
# NOT your real Gmail password. Generate one at:
#   https://myaccount.google.com/apppasswords   (requires 2FA on the account)
# Without 2FA + App Passwords, Gmail SMTP will reject auth with EAUTH 535.
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=replace-with-16-char-app-password

# OTP lifetime (minutes) for both signup_verify and login_mfa.
OTP_TTL_MINUTES=10
# How long the "pending token" returned after password verify stays valid (seconds).
# Should be >= OTP_TTL_MINUTES * 60 plus a small grace window.
OTP_PENDING_TTL_SECONDS=900
# Hard cap on wrong-OTP attempts per otp_codes row before it is invalidated.
OTP_MAX_ATTEMPTS=5
# Minimum seconds between two resend-otp calls for the same (user, purpose).
OTP_RESEND_COOLDOWN_SECONDS=60
